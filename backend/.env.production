# ============================================================================
# GEB Backend Environment Variables - PRODUCTION
# Use this as a template for your production deployment
# ============================================================================

# === Core Application ===
APP_NAME=Personalized News Aggregation MVP
ENVIRONMENT=production
LOG_LEVEL=WARNING

# === Security ===
# IMPORTANT: Use strong, random values for production!
SECRET_KEY=your-production-secret-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Token encryption key for storing OAuth credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-production-encryption-key

# === Database ===
# PostgreSQL for production (Railway, Render, AWS RDS)
DATABASE_URL=postgresql://user:password@db.example.com:5432/geb_db

# === Redis / Celery ===
# Upstash or Railway Redis for production
CELERY_BROKER_URL=redis://default:password@upstash-redis-host:port
CELERY_RESULT_BACKEND=redis://default:password@upstash-redisCELERY_RESULT_BACKEND=redis://default:password@RNING_RATE=0.02
DECAY_FACTOR=0.995
SIMILARITY_THRESHOLD=0.85
TOP_N_STORIES=30

# === Data ===
DATASET_PATH=./data/webhose_sample/news.jsonl

# ============================================================================
# WeChat Integration
# ============================================================================

# --- WeChat OAuth ---
# Register OAuth app at: https://mp.weixin.qq.com/
WECHAT_APP_ID=your-production-wecWECHAT_APP_ID=your-production-wecWECHAT_APP_ID=yout-aWECHAT_APP_ID=your-production-wecWECHAT_APP_ID=your-production-wecWECHAT_APP_ID=yout-aWECHAT_APP_ID=your-


ECHAT_APP_ID=your-production-wecWECHAT_APP_IARTICLE_CACHE_TTL=3600
WECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHW=6WECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHW=6WECHWChatWECHWECHWECHWECHWECHWECssWECHWECHWECHWECHWECHWECHWECHWECHWECHWECHple.com
WEWE_RSS_AUTH_CODE=your-production-auth-code

# ============================================================================
# AI Service (Ollama Cloud)
# ============================================================================
OLLAMA_API_KEY=your-production-ollama-api-key
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=mistral

# ===============================================# ===================# ===============================================# =============================================================
FRONTEND_URL=https://yourdomain.com
VERCEL_URL=your-app.vercel.app
