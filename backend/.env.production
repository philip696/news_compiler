# ============================================================================
# GEB Backend Environment Variables - PRODUCTION
# Use this as a template for your production deployment
# ============================================================================

# === Database ===
# For local development (SQLite):
# DATABASE_URL=sqlite:///./data/geb.db

# For production (Supabase Postgres — replace YOUR_DB_PASSWORD):
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.mycmkjreudidzouketib.supabase.co:5432/postgres

# === Redis / Celery ===
# For local development:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# For production (Upstash or Railway Redis):
CELERY_BROKER_URL=redis://default:password@host:port
CELERY_RESULT_BACKEND=redis://default:password@host:port

# === Security ===
# IMPORTANT: Use strong, random values for production!
SECRET_KEY=your-production-secret-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Token encryption key for storing OAuth credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-production-encryption-key

# === Database ===
# PostgreSQL for production (Railway, Render, AWS RDS)
DATABASE_URL=postgresql://user:password@db.example.com:5432/geb_db

# === Redis / Celery ===
# Upstash or Railway Redis for production
CELERY_BROKER_URL=redis://default:password@upstash-redis-host:port
CELERY_RESULT_BACKEND=redis://default:password@upstash-redisCELERY_RESULT_BACKEND=redis://default:password@RNING_RATE=0.02
DECAY_FACTOR=0.995
SIMILARITY_THRESHOLD=0.85
TOP_N_STORIES=30

# === Data ===
DATASET_PATH=./data/webhose_sample/news.jsonl

