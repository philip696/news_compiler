# ============================================================================
# GEB Backend Environment Variables
# Copy this to .env and fill in your values
# ============================================================================

# === Core Application ===
APP_NAME=Personalized News Aggregation MVP
# Railway / Docker: leave unset so WebHose+Kaggle ingest runs in the background and
# /healthz responds immediately (avoids deploy health-check timeouts). For local
# debugging of ingest order, set STARTUP_INGEST_SYNC=1 to block until load finishes.
# STARTUP_INGEST_SYNC=1

# === AI (DeepSeek, OpenAI-compatible) ===
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Token encryption key for storing OAuth credentials securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required if storing WeChat OAuth access_token/refresh_token
TOKEN_ENCRYPTION_KEY=

# === Database ===
# Local dev (SQLite) — default if DATABASE_URL unset in app/db/database.py:
# DATABASE_URL=sqlite:///./data/geb.db
#
# Supabase / PostgreSQL — Dashboard → Connect → URI (for Alembic / optional SQLAlchemy):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Runtime API data access: when BOTH are set, the app uses Supabase PostgREST (HTTP) instead
# of SQLAlchemy for all user/bookmark/like/weread data (service role = server only):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
#
# If deploy logs show IPv6 "Network is unreachable" for db.*.supabase.co, either:
#   1) Set DATABASE_IPV4_ONLY=true (resolves hostname to IPv4; TLS still uses hostname), or
#   2) Use Supabase "Connection pooling" URI (Transaction mode, port 6543) instead.
# DATABASE_IPV4_ONLY=true

# Optional: only if you call Supabase REST from Python (not used for SQLAlchemy)
# SUPABASE_SERVICE_ROLE_KEY=

LEARNING_RATE=0.02
DECAY_FACTOR=0.995
SIMILARITY_THRESHOLD=0.85
TOP_N_STORIES=30
DATASET_PATH=./data/webhose_sample/news.jsonl
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === WeRead / WeChat Official Account integration ===
# Upstream WeRead gateway (wewe-rss compatible). Default is a public community
# gateway; you can also self-host wewe-rss and point this at it.
# PLATFORM_URL=
# Seconds between history pages / feeds (wewe-rss default; reduces blocking risk)
UPDATE_DELAY_TIME=60
# Optional: override UPDATE_DELAY_TIME with an explicit millisecond delay (dev only)
# UPDATE_DELAY_MS=2000
