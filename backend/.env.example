# ============================================================================
# GEB Backend Environment Variables
# Copy this to .env and fill in your values
# ============================================================================

# === Core Application ===
APP_NAME=Personalized News Aggregation MVP

# === AI (DeepSeek, OpenAI-compatible) ===
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# PostgreSQL (Supabase): paste URI from Dashboard → Connect or Settings → Database
# Leave unset to use local SQLite (see app/db/database.py)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional: only if you call Supabase REST from Python (not used for SQLAlchemy)
# SUPABASE_SERVICE_ROLE_KEY=

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Token encryption key for storing OAuth credentials securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required if storing WeChat OAuth access_token/refresh_token
TOKEN_ENCRYPTION_KEY=

# === Database ===
# For local development (SQLite):
DATABASE_URL=sqlite:///./data/geb.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:543# DATABASE_URL=postgresql://user:password@localhost:543# DATABASE_URL=postgRL# DATABASE_URL=postgresql://user:password@localhost:543# DATABASE_URL=postgreor# DATABASE_URL=postgresql://user:pdi# DATABASE_URL=postgresql://user:passworpassword@host:port
# CELERY_RESULT_BACKEND=redis://default:password@host:port

# ===# ===# ===# ===# ===# ====
LEARNING_RATE=0.02
DECAY_FACTOR=0.995
SIMILARITY_THRESHOLD=0.85
TOP_N_STORIES=30
DATASET_PATH=./data/webhose_sample/news.jsonl
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# === WeRead / WeChat Official Account integration ===
# Upstream WeRead gateway (wewe-rss compatible). Default is a public community
# gateway; you can also self-host wewe-rss and point this at it.
# PLATFORM_URL=
# Seconds between history pages / feeds (wewe-rss default; reduces blocking risk)
UPDATE_DELAY_TIME=60
# Optional: override UPDATE_DELAY_TIME with an explicit millisecond delay (dev only)
# UPDATE_DELAY_MS=2000