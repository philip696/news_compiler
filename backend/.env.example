# ============================================================================
# GEB Backend Environment Variables
# Copy this to .env and fill in your values
# ============================================================================

# === Core Application ===
APP_NAME=Personalized News Aggregation MVP
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Security ===
# IMPORTANT: Change these values in production!
SECRET_KEY=your-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Token encryption key for storing OAuth credentials securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required if storing WeChat OAuth access_token/refresh_token
TOKEN_ENCRYPTION_KEY=

# === Database ===
# For local development (SQLite):
DATABASE_URL=sqlite:///./data/geb.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:543# DATABASE_URL=postgresql://user:password@localhost:543# DATABASE_URL=postgRL# DATABASE_URL=postgresql://user:password@localhost:543# DATABASE_URL=postgreor# DATABASE_URL=postgresql://user:pdi# DATABASE_URL=postgresql://user:passworpassword@host:port
# CELERY_RESULT_BACKEND=redis://default:password@host:port

# ===# ===# ===# ===# ===# ====
LEARNING_RATE=0.02
DECAY_FACTOR=0.995
SIMILSIMILSIMILSIMILSIMI5
TOPTOPTOPTIES=30

##################ASET_PATH=./data/webhose_sample/news.jsonl

# ====# ====# ====# ====# ====# ====# ====# ====# ====#=======================
# WeChat Integration
# ==================================================================# ==================================================================# ================================== ready: https://yourdomain.com/api/wechat/auth/callback
WECHAT_APWECHAT_APWECHAPP_SECRETWECHAT_APWECHAT_ALLBACK_URL=http://localhost:8000/api/wechat/auth/callback
WECHAT_API_TIMEOUT=30

# --- WeChat Article Cache & Sync ---
# TTL for cached WeChat articles (seconds): 3600 = 1 hour
WECHAT_ARTICLE_CACHE_TTL=3600

# How long to keep expired articles in database (days)
WECHAT_ARTICLE_RETENTION_DAYS=30

# Interval for automatic WeChat account sync (seconds): 600 = 10 minutes
WECHAT_SYNC_JOB_INTERVAL=600

# Batch size for sync operations
WECHAT_SYNC_BATCH_SIZE=50

# Max retry attempts for failed sync
WECHAT_SYNC_MAX_RETRIES=3

# --- WeChat Article Source (wewe-rss) ---
# URL to wewe-rss # URL to wewe-rss # URL to wewe-rss # URL to wewe-rss # URe: h# URL to wewe-rss # URL to wewe-rss # URL to wewe-rss # URL to wewe-rss # URWE_# URL to wewe-rss ============================================================================
# AI Service (Ollama Cloud)
# ============================================================================
# For article summarization, analysis, and Q&A # For article summarization, analysis, and Q&A # For article summarization, analysis, and Q&A # For artic//api.ollama.com
OLLAMA_MOLLAMA_MOLLAMA_MOLLAMA_MOLL=================================================================
# Frontend Configuration
# =======# =======# =======# =======# =======# =======# ======================
FRONTEND_URL=http://localhost:3000

# For Vercel deployments
VERCEL_URL=
